# --- apps/agent/.env ---
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-haiku-4-5
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
MCP_SERVER_URL=http://localhost:3001
MCP_SERVER_TOKEN=placeholder-mcp-server-token
VAPI_PRIVATE_KEY=placeholder-vapi-private-key
VAPI_SERVER_SECRET=placeholder-vapi-server-secret
PORT=3000
# Public anon key, safe to expose via GET /api/config — powers the
# specialist dashboard's Supabase Auth session in the browser.
SUPABASE_ANON_KEY=placeholder-supabase-anon-key
# Gmail SMTP — see docs/deployment.md for the App Password setup steps.
GMAIL_USER=placeholder-gmail-address@gmail.com
GMAIL_APP_PASSWORD=placeholder-gmail-app-password
SUPPORT_TEAM_EMAIL=placeholder-gmail-address@gmail.com

# --- apps/agent/public (browser-exposed, not secret) ---
VAPI_PUBLIC_KEY=placeholder-vapi-public-key
VAPI_ASSISTANT_ID=placeholder-vapi-assistant-id

# --- apps/mcp-server/.env ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
MCP_SERVER_TOKEN=placeholder-mcp-server-token
GMAIL_USER=placeholder-gmail-address@gmail.com
GMAIL_APP_PASSWORD=placeholder-gmail-app-password
SUPPORT_TEAM_EMAIL=placeholder-gmail-address@gmail.com
